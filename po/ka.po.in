#, c-format
msgid "setting '%s' to '%s'\n"
msgstr ""

#. TRANSLATORS: the following counts refer to streets
msgid "zeroth"
msgstr "მენულე"

msgid "first"
msgstr "პირველი"

msgid "second"
msgstr "წამი"

msgid "third"
msgstr "მესამე"

msgid "fourth"
msgstr "მეოთხე"

msgid "fifth"
msgstr "მეხუთე"

msgid "sixth"
msgstr "მეექვსე"

#. TRANSLATORS: the following counts refer to roundabout exits
msgid "zeroth exit"
msgstr "მენულე გასასვლელი"

msgid "first exit"
msgstr "პირველი გასასვლელი"

msgid "second exit"
msgstr "მეორე გასასვლელი"

msgid "third exit"
msgstr "მესამე გასასვლელი"

msgid "fourth exit"
msgstr "მეოთხე გასასვლელი"

msgid "fifth exit"
msgstr "მეხუთე გასასვლელი"

msgid "sixth exit"
msgstr "მეექვსე გასასვლელი"

#, c-format
msgid "%d feet"
msgstr "%d ფუტი"

#, c-format
msgid "in %d feet"
msgstr "%d ფუტში"

#, c-format
msgid "%d.%d miles"
msgstr "%d.%d მილი"

#, c-format
msgid "in %d.%d miles"
msgstr ""

#, c-format
msgid "one mile"
msgid_plural "%d miles"
msgstr[0] "ერთი მილი"
msgstr[1] "%d მილი"

#, c-format
msgid "in one mile"
msgid_plural "in %d miles"
msgstr[0] "ერთ მილში"
msgstr[1] "%d მილში"

#, c-format
msgid "%d meters"
msgstr "%d მეტრი"

#, c-format
msgid "in %d meters"
msgstr "%d მეტრში"

